{
  "info": {
    "_postman_id": "b189c423-f268-45e3-9790-a3597c234a9b",
    "name": "Jajal Medical Case Management API",
    "description": "Postman API Collection for Jajal Medical Services Case Management REST API with Laravel Sanctum Bearer token authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "POST /api/login (Admin Login)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@jajalmedical.com\",\n  \"password\": \"AdminPassword123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": ["{{base_url}}"],
              "path": ["api", "login"]
            },
            "description": "Authenticate Admin credentials and receive Sanctum Bearer token."
          }
        },
        {
          "name": "POST /api/login (Viewer Login)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"viewer@jajalmedical.com\",\n  \"password\": \"ViewerPassword123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": ["{{base_url}}"],
              "path": ["api", "login"]
            },
            "description": "Authenticate Viewer credentials and receive Sanctum Bearer token."
          }
        },
        {
          "name": "POST /api/logout",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "logout"]
            },
            "description": "Revoke currently active Sanctum access token."
          }
        }
      ]
    },
    {
      "name": "2. Cases API",
      "item": [
        {
          "name": "GET /api/cases (List & Filter)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/cases?page=1&per_page=10&status=Planning&search=Titanium",
              "host": ["{{base_url}}"],
              "path": ["api", "cases"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "Planning",
                  "description": "Filter by Draft, Planning, In Review, Approved, Completed, Cancelled"
                },
                {
                  "key": "search",
                  "value": "Titanium",
                  "description": "Search by Case Number or Surgeon Name"
                }
              ]
            },
            "description": "Retrieve paginated case list. Accessible to Admin and Viewer."
          }
        },
        {
          "name": "POST /api/cases (Create Case - Admin Only)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"case_number\": \"CAS-30001\",\n  \"patient_reference\": \"PT-9988\",\n  \"surgeon_name\": \"Dr. Benjamin Stone\",\n  \"implant_type\": \"Ceramic Hip Replacement Kit\",\n  \"status\": \"Planning\",\n  \"priority\": \"High\",\n  \"surgery_date\": \"2026-11-20\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/cases",
              "host": ["{{base_url}}"],
              "path": ["api", "cases"]
            },
            "description": "Create a new clinical case. Admin role required. Creator is automatically set."
          }
        },
        {
          "name": "GET /api/cases/{id} (Single Case Details)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/cases/1",
              "host": ["{{base_url}}"],
              "path": ["api", "cases", "1"]
            },
            "description": "Retrieve single case details by ID. Accessible to Admin and Viewer."
          }
        },
        {
          "name": "PUT /api/cases/{id} (Update Case - Admin Only)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"case_number\": \"CAS-10001\",\n  \"patient_reference\": \"PT-9011\",\n  \"surgeon_name\": \"Dr. Sophia Reyes\",\n  \"implant_type\": \"Titanium Total Knee System v2\",\n  \"status\": \"Approved\",\n  \"priority\": \"High\",\n  \"surgery_date\": \"2026-11-25\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/cases/1",
              "host": ["{{base_url}}"],
              "path": ["api", "cases", "1"]
            },
            "description": "Update case by ID. Admin role required. Unique case_number rule ignores current record."
          }
        },
        {
          "name": "DELETE /api/cases/{id} (Delete Case - Admin Only)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/cases/1",
              "host": ["{{base_url}}"],
              "path": ["api", "cases", "1"]
            },
            "description": "Delete case by ID. Admin role required. Forbidden (403) for Viewer."
          }
        }
      ]
    }
  ]
}
